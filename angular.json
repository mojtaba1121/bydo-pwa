{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "bydo-pwa": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "bydo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/bydo-pwa",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "800kB", "maximumError": "1.5MB" }], "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "bydo-pwa:build:production" }, "development": { "buildTarget": "bydo-pwa:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
